# ==========================================================
# Environment configuration template.
# Copy to `.env` and adjust as needed. All values are optional;
# sensible defaults live in config.py.
# ==========================================================

# ---- Detection ----
CONF_THRESHOLD=0.35
IOU_THRESHOLD=0.45
IMG_SIZE=640
DEVICE=cpu                 # cpu | 0 | cuda:0

# ---- GPS simulation ----
GPS_START_LAT=12.9716
GPS_START_LON=77.5946
GPS_STEP_METRES=15.0

# ---- Reverse geocoding ----
GEOCODER_AGENT=smart_road_monitor
GEOCODER_TIMEOUT=10
GEOCODER_MIN_DELAY=1.1

# ---- Application ----
ORGANIZATION=Municipal Corporation
LOG_LEVEL=INFO
